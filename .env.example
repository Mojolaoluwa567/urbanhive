# ── Server ───────────────────────────────────────────────
PORT=4000

# Full public URL of your site (used in verification + magic-link emails).
# In production set this to e.g. https://urbanhive.com
SITE_URL=http://localhost:4000

# Comma-separated list of origins allowed to call the API.
# Use * only for local testing. In production, set this to your real domain,
# e.g. https://urbanhive.com (only needed if the frontend is hosted separately
# from this backend — if Express is serving public/ itself, you can leave this).
FRONTEND_ORIGIN=*

# ── Admin auth ───────────────────────────────────────────
# JWT_SECRET signs admin login sessions. Generate a random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Used ONLY the very first time the server runs, to create the first admin
# account. After that, change the password from the admin Settings panel —
# these values are ignored once an admin user exists in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run

# ── Google OAuth ─────────────────────────────────────────
# Get these from https://console.cloud.google.com
# Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Application type: Web application
# Authorised redirect URIs — add ALL of these you use:
#   http://localhost:4000/api/users/auth/google/callback
#   https://your-app.onrender.com/api/users/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Must be an email address on a domain you've verified in Resend.
# For quick testing without your own domain, you can use Resend's
# shared test sender (delivers to YOUR account's verified address only):
#   RESEND_FROM=UrbanHive <onboarding@resend.dev>
RESEND_FROM=UrbanHive <onboarding@resend.dev>

# Where contact-form submissions get emailed to.
CONTACT_TO_EMAIL=youremail@example.com
